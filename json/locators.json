{
    "jiuyan": {
        "url": "https://www.jiuyangongshe.com",
        "wait_for_dynamical": null,
        "locators": {
          "login_dialog": {
            "by": "css",
            "value": "div.el-dialog__body"
          },
          "open_login_btn": {
            "by": "css",
            "value": "div.name.lf"
          },
          "tab_switch": {
            "by": "css",
            "value": "div#tab-accounts"
          },
          "check_box": null,
          "phone_input": {
            "by": "css",
            "value": "div#pane-accounts input[name='phone']"
          },
          "pwd_input": {
            "by": "css",
            "value": "div#pane-accounts input[name='password']"
          },
          "login_btn": {
            "by": "css",
            "value": "div#pane-accounts button.el-button--primary"
          }
        }
      },
    "xuangutong":  {
        "url": "https://xuangutong.com.cn",
        "wait_for_dynamical": null,
        "locators": {
          "login_dialog": {
            "by": "css",
            "value": "form.form-login"
          },
          "open_login_btn": {
            "by": "css",
            "value": "span.go-login"
          },
          "tab_switch": {
            "by": "css",
            "value": "span.switch-item"
          },
          "check_box": null,
          "phone_input": {
            "by": "css",
            "value": "input[placeholder='请输入手机号']"
          },
          "pwd_input": {
            "by": "css",
            "value": "input[placeholder='请输入密码']"
          },
          "login_btn": {
            "by": "css",
            "value": "button.submit[type='submit']"
          }
        }
      },
    "gangtise":  {
        "url": " https://open.gangtise.com/",
        "wait_for_dynamical": {"by": "css", "value": "div.hotspot-top"},
        "locators": {
          "login_dialog": {
            "by": "css",
            "value": "div.login-box"
          },
          "open_login_btn": null,
          "tab_switch": null,
          "check_box": [
            {
              "by": "css",
              "value": "div.privacyPolicy .el-checkbox__input"
            },
            {
              "by": "xpath",
              "value": "//span[contains(@class,'el-checkbox__label')]//*[text()='记住密码']/ancestor::label//span[contains(@class,'el-checkbox__input')]"
            },
            {
              "by": "xpath",
              "value": "//span[contains(@class,'el-checkbox__label')]//*[text()='自动登录']/ancestor::label//span[contains(@class,'el-checkbox__input')]"
            }
          ],
          "phone_input": {
            "by": "css",
            "value": "input.login-phone[placeholder='请输入您的手机号/账号']"
          },
          "pwd_input": {
            "by": "css",
            "value": "input.login-password_[placeholder='请输入密码']"
          },
          "login_btn": {
            "by": "xpath",
            "value": "//div[contains(@class,'login-button') and normalize-space(text())='登录']"
          }
        }
      },

    "alphapai":  {
        "url": "https://alphapai-web.rabyte.cn/reading/paipai/index",
        "wait_for_dynamical": null,
        "locators": {
          "login_dialog": {
            "by": "css",
            "value": "div.login-box"
          },
          "open_login_btn": null,
          "tab_switch": {
            "by": "xpath",
            "value": "//a[contains(text(),'账号密码登录')]"
          },
          "check_box": null,
          "phone_input": {
            "by": "xpath",
            "value": "//input[@placeholder='请输入手机号']"
          },
          "pwd_input": {
            "by": "xpath",
            "value": "//input[@placeholder='请输入密码']"
          },
          "login_btn": {
            "by": "xpath",
            "value": "//div[contains(text(),'登录') or contains(text(),'登 录')]"
          }
        }
      }
}