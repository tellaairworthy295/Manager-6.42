      "content_locator": null
    },
    "https://open.gangtise.com/?ai/knowledge=%2Fknowledge%2F%3Ft%3D1765246113209%23%2Fknowledge#/ai/knowledge": {
      "name": "gangtise",
      "click_locator": { "by": "xpath", "value": "//div[contains(@class, 'menu-item') and .//div[@class='title-open'][text()='AI助手']]" },
      "text_box_locator": { "by": "css", "value": "textarea.el-textarea__inner" },
      "finish_locator": { "by": "css", "value": "div.agent-utils flex" },
