        "row_selector": "ul.td-box li.row",
        "name_selector": ".fs15-bold",
        "code_selector": ".fs12-bold-ash",
        "analysis_selector": "pre",
        "image": true,
        "cookies": true
      },
      "https://xuangutong.com.cn/dingpan": {
        "name": "xuangutong",
        "click_selector": null,
        "row_selector": "tbody.hit-pool__table-body tr",
        "name_selector": ".stock-title-name",
        "code_selector": ".stock-title a",
        "analysis_selector": ".stock-reason span.line-clamp",
        "image": false,
        "cookies": true
