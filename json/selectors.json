        "unwanted_content": [
          "Bloomberg may send me offers and promotions.",
          "By submitting my information, I agree to the Privacy Policy and Terms of Service"
        ]
      },
      "reuters.com": {
        "selector": "div.article-body-module__content__bnXL1 div[data-testid*='paragraph']",
        "min_paragraphs": 5,
        "unwanted_content": []
      }
    },
  "stocks": {
